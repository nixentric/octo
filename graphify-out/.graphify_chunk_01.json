    {
      "id": "readme_encrypted_session_cookie",
      "label": "AES-GCM Encrypted HttpOnly Session Cookie",
      "file_type": "rationale",
      "source_file": "/Users/nixentric/Documents/Project/octo/README.md",
      "source_location": "L94",
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "GitHub tokens are never sent to the browser; they are kept only inside an AES-GCM encrypted, HttpOnly cookie that client-side JavaScript cannot read."
    },
    {
      "id": "readme_git_provider_abstraction",
      "label": "GitProvider Abstraction",
      "file_type": "rationale",
      "source_file": "/Users/nixentric/Documents/Project/octo/README.md",
      "source_location": "L95",
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "worker/providers/git/types.ts defines the GitProvider interface and github.ts is meant to be the only GitHub-aware code, so the rest of the app depends on the interface instead of on GitHub."
    },
    {
      "id": "readme_framework_agnostic_core",
      "label": "Framework-Agnostic Core Layer",
      "file_type": "rationale",
      "source_file": "/Users/nixentric/Documents/Project/octo/README.md",
      "source_location": "L89",
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "core/ holds the zod config schema, frontmatter handling and shared types with no React and no GitHub dependencies, keeping it independent of both the UI and the Git host."
