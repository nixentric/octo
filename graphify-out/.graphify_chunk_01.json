    {
      "id": "readme_git_based_content_storage",
      "label": "Git-Based Content Storage (No Database)",
      "file_type": "rationale",
      "source_file": "/Users/nixentric/Documents/Project/octo/README.md",
      "source_location": "L3",
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "Content lives in the site's GitHub repository as Markdown + frontmatter and every save is a commit, so no database is needed; the same repository then feeds the static site build."
    },
    {
      "id": "readme_request_flow",
      "label": "Worker-Proxied Request Flow",
      "file_type": "rationale",
      "source_file": "/Users/nixentric/Documents/Project/octo/README.md",
      "source_location": "L6",
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "The React browser app never calls GitHub directly: it only talks to the Cloudflare Worker's /api and /auth routes, which call the GitHub API against the site repository that the static site build consumes."
    },
